<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PivotForge.Core</PackageId>
    <Title>PivotForge Core</Title>
    <Description>A fast, dependency-light pivot table engine for .NET. Build pivot results from objects, dictionaries, DataTables, JSON, and CSV with grouping, aggregation, filtering, sorting, show-as calculations, drill-down, pagination, cancellation, and Excel export.</Description>
    <PackageTags>pivot;pivot-table;pivot-grid;crosstab;aggregation;analytics;reporting;drill-down;excel;dotnet</PackageTags>
  </PropertyGroup>

</Project>
