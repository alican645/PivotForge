<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>PivotForge.AspNetCore</PackageId>
    <Title>PivotForge for ASP.NET Core</Title>
    <Description>An interactive ASP.NET Core pivot table UI powered by PivotForge. Includes static web assets, endpoint registration, drill-down, Excel and CSV export, conditional formatting, large-data paging, request cancellation, and caching.</Description>
    <PackageTags>aspnetcore;pivot;pivot-table;pivot-grid;data-grid;virtualization;drill-down;reporting;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../PivotForge.Core/PivotForge.Core.csproj" />
  </ItemGroup>

</Project>
