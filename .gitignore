# Build outputs
**/bin/
**/obj/
# The contents rather than the directory itself: git cannot re-include a file
# whose parent directory is excluded, and one file in here is configuration.
artifacts/*
# Repository configuration rather than build output: without it a fresh clone's
# smoke projects fail restore under central package management.
!artifacts/Directory.Packages.props

# IDE and user settings
.idea/
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Test and coverage outputs
TestResults/
coverage/
*.coverage
*.coveragexml

# Package and frontend caches
*.nupkg
*.snupkg
node_modules/

# Local configuration and secrets
.env
.env.*
!.env.example
appsettings.Local.json
secrets.json

# Operating system files
.DS_Store
Thumbs.db

# Playwright browser-test output
test-results/
playwright-report/
