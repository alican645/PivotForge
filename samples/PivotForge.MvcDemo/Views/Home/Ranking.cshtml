@model IReadOnlyList<SalesRecord>
@{
    ViewData["Title"] = "Top-N örneği";
}

<main class="pivot-shell">
    <header class="pivot-topbar">
        <div class="pivot-brand">
            <strong>En iyi N grup</strong>
            <span>@Model.Count kayıt · <code>pivot-top-n</code></span>
        </div>
        <nav class="pivot-actions">
            <a class="pivot-button" asp-controller="Home" asp-action="Index">Tam demo</a>
            <a class="pivot-button primary" asp-controller="Home" asp-action="TagHelpers">TagHelper sürümü</a>
        </nav>
    </header>

    <section class="pivot-content">
        <div class="pivot-card">
            <div class="pivot-panel-head">
                <h2>Nasıl çalışıyor?</h2>
            </div>
            <p>
                <code>&lt;pivot-top-n field="Region" count="3" /&gt;</code> satır eksenindeki
                bölge seviyesini en yüksek üç bölgeye indiriyor. Bu bir <em>filtre değil</em>:
                filtre hangi kaydın hesaba katılacağına karar verir, sıralama ise ancak
                <strong>toplama bittikten sonra</strong> var olan grupları karşılaştırır.
            </p>
            <p>
                İkinci sıralama iç seviyeye uygulanıyor: her bölgenin kendi içinde en iyi iki
                kategorisi kalıyor. Sayı tablo genelinde değil, <strong>her üst grubun
                içinde</strong> sayılıyor — yoksa tek bir bölge bütün kotayı doldururdu.
            </p>
            <p>
                Elenen satırlar sonuçtan tümüyle çıkıyor, toplamlar dahil. Genel toplam
                ekrandaki satırların toplamına eşit; okuyucunun elle kontrol ettiği tek sayı
                budur ve tutmaması, özelliğin kendisinden daha kötüdür. Bunun bedeli, sıralama
                bildirilen isteklerde kayıtların bir kez daha taranması.
            </p>
        </div>

        <div class="pivot-workspace">
            <aside class="pivot-sidebar" aria-label="PivotTable alanları">
                <div id="rankingDesignerHost" aria-label="Pivot alan tasarımcısı"></div>
            </aside>

            <div class="pivot-card">
                <pivot-grid id="rankingGrid"
                            allow-sorting="true"
                            allow-filtering="true"
                            allow-drill-down="true"
                            source-row-count="@Model.Count"
                            min-column-width="96"
                            total-text="Genel Toplam"
                            aria-label="En iyi bölgeler ve kategorileri"
                            culture="tr-TR"
                            field-designer="#rankingDesignerHost">
                    <pivot-field field="Region" caption="Bölge" area="Row" />
                    <pivot-field field="Category" caption="Kategori" area="Row" />
                    <pivot-field field="Year" caption="Yıl" area="Column" />
                    <pivot-field field="Amount" caption="Tutar" area="Data" aggregation="Sum"
                                 format-type="Currency" format-decimals="0" format-currency="TRY" />
                    <pivot-field field="Quantity" caption="Adet" area="Available" role="Measure" />
                    <pivot-top-n field="Region" count="3" />
                    <pivot-top-n field="Category" count="2" />
                </pivot-grid>
            </div>
        </div>

        <div class="pivot-card">
            <div class="pivot-panel-head">
                <h2>Kaynağı</h2>
            </div>
            <pre><code>&lt;pivot-grid id="rankingGrid" field-designer="#rankingDesignerHost" culture="tr-TR"&gt;
    &lt;pivot-field field="Region"   caption="Bölge"    area="Row" /&gt;
    &lt;pivot-field field="Category" caption="Kategori" area="Row" /&gt;
    &lt;pivot-field field="Amount"   caption="Tutar"    area="Data" aggregation="Sum" /&gt;

    &lt;!-- En iyi üç bölge, ve her bölgenin kendi içinde en iyi iki kategorisi --&gt;
    &lt;pivot-top-n field="Region"   count="3" /&gt;
    &lt;pivot-top-n field="Category" count="2" /&gt;
&lt;/pivot-grid&gt;</code></pre>
            <p>
                <code>value-key</code> ile hangi ölçünün sıraladığı seçilebiliyor
                (<code>value-key="Quantity_sum"</code>), <code>mode="Bottom"</code> ile de
                sıralamanın diğer ucu alınıyor.
            </p>
        </div>
    </section>
</main>
