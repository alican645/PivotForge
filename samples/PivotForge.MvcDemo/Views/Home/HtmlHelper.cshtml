@model IReadOnlyList<SalesRecord>
@{
    ViewData["Title"] = "HTML Helper örneği";
}

<main class="pivot-shell">
    <header class="pivot-topbar">
        <div class="pivot-brand">
            <strong>HTML Helper ile pivot tablo</strong>
            <span>@Model.Count kayıt · <code>Html.PivotForge().PivotGrid()</code> akıcı API'si</span>
        </div>
        <nav class="pivot-actions">
            <a class="pivot-button" asp-controller="Home" asp-action="Index">Tam demo</a>
            <a class="pivot-button primary" asp-controller="Home" asp-action="TagHelpers">TagHelper sürümü</a>
        </nav>
    </header>

    <section class="pivot-content">
        <div class="pivot-card">
            <div class="pivot-panel-head">
                <h2>Nasıl çalışıyor?</h2>
            </div>
            <p>
                Bu sayfa tek satır elle yazılmış JavaScript içermiyor. Akıcı yardımcı hem
                kapsayıcı işaretlemeyi hem de onu ayağa kaldıran <code>PivotForge.create</code>
                çağrısını üretiyor; veri <code>Program.cs</code> içinde
                <code>AddPivotForge&lt;SalesRecord&gt;</code> ile kaydedilen sağlayıcıdan geliyor.
            </p>
            <p>
                <a asp-controller="Home" asp-action="TagHelpers">TagHelper sürümü</a> birebir aynı
                tabloyu üretir — tek fark bildirimin C# mi yoksa işaretleme mi olduğudur.
            </p>
        </div>

        <div class="pivot-workspace">
            <aside class="pivot-sidebar" aria-label="PivotTable alanları">
                @* The packaged designer owns this element and replaces its children,
                   so nothing else may live inside it. *@
                <div id="designerHost" aria-label="Pivot alan tasarımcısı"></div>
            </aside>

            <div class="pivot-card">
                @(Html.PivotForge().PivotGrid()
                    .Id("pivotGrid")
                    .AllowSorting(true)
                    .AllowFiltering(true)
                    .AllowDrillDown(true)
                    .AllowExcelExport(true)
                    .SourceRowCount(Model.Count)
                    .SelectionMode(PivotSelectionMode.Single)
                    .LayoutMode(PivotGridLayoutMode.Tabular)
                    .ContextMenu(true)
                    .Subtotals(true)
                    .ShowGrandTotal(true)
                    .RepeatRowLabels(true)
                    .MinColumnWidth(96)
                    .TotalText("Genel Toplam")
                    .OnSelectionChanged("pivotSelectionChanged")
                    .RowSort(PivotSort.RowTotal("Amount_sum", PivotSortDirection.Descending))
                    .ConditionalRule("Amount_sum", PivotConditionalOperator.GreaterThanOrEqual,
                        900000, PivotConditionalColor.Green, id: "yuksek")
                    .FieldDesigner("#designerHost")
                    .Fields(fields =>
                    {
                        fields.Add().Caption("Bölge").DataField("Region").Area(PivotArea.Row);
                        fields.Add().Caption("Kategori").DataField("Category").Area(PivotArea.Row);
                        fields.Add().Caption("Yıl").DataField("Year").Area(PivotArea.Column);
                        fields.Add().Caption("Tutar").DataField("Amount")
                            .Aggregation(PivotAggregation.Sum).Area(PivotArea.Data)
                            .FormatType(PivotValueFormatType.Currency)
                            .FormatDecimals(0).FormatCurrency("TRY");
                        fields.Add().Caption("Satış Temsilcisi").DataField("SalesPerson")
                            .Area(PivotArea.Available).Role(PivotFieldRole.Dimension);
                        fields.Add().Caption("Çeyrek").DataField("Quarter")
                            .Area(PivotArea.Available).Role(PivotFieldRole.Dimension);
                        fields.Add().Caption("Miktar").DataField("Quantity")
                            .Area(PivotArea.Available).Role(PivotFieldRole.Measure);
                        fields.Add().Caption("İskonto").DataField("Discount")
                            .Area(PivotArea.Available).Role(PivotFieldRole.Measure);
                    }))
            </div>
        </div>

        <div class="pivot-card">
            <div class="pivot-panel-head">
                <h2>Kaynağı</h2>
            </div>
            <pre><code>@@(Html.PivotForge().PivotGrid()
    .Id("pivotGrid")
    .AllowSorting(true)
    .AllowFiltering(true)
    .AllowDrillDown(true)
    .AllowExcelExport(true)
    .SourceRowCount(Model.Count)
    .SelectionMode(PivotSelectionMode.Single)
    .LayoutMode(PivotGridLayoutMode.Tabular)
    .ContextMenu(true)
    .Subtotals(true)
    .ShowGrandTotal(true)
    .RepeatRowLabels(true)
    .MinColumnWidth(96)
    .TotalText("Genel Toplam")
    .OnSelectionChanged("pivotSelectionChanged")
    .RowSort(PivotSort.RowTotal("Amount_sum", PivotSortDirection.Descending))
    .ConditionalRule("Amount_sum", PivotConditionalOperator.GreaterThanOrEqual,
        900000, PivotConditionalColor.Green, id: "yuksek")
    .FieldDesigner("#designerHost")
    .Fields(fields =&gt;
    {
        fields.Add().Caption("Bölge").DataField("Region").Area(PivotArea.Row);
        fields.Add().Caption("Kategori").DataField("Category").Area(PivotArea.Row);
        fields.Add().Caption("Yıl").DataField("Year").Area(PivotArea.Column);
        fields.Add().Caption("Tutar").DataField("Amount")
            .Aggregation(PivotAggregation.Sum).Area(PivotArea.Data)
            .FormatType(PivotValueFormatType.Currency)
            .FormatDecimals(0).FormatCurrency("TRY");
        fields.Add().Caption("Satış Temsilcisi").DataField("SalesPerson")
            .Area(PivotArea.Available).Role(PivotFieldRole.Dimension);
        fields.Add().Caption("Çeyrek").DataField("Quarter")
            .Area(PivotArea.Available).Role(PivotFieldRole.Dimension);
        fields.Add().Caption("Miktar").DataField("Quantity")
            .Area(PivotArea.Available).Role(PivotFieldRole.Measure);
        fields.Add().Caption("İskonto").DataField("Discount")
            .Area(PivotArea.Available).Role(PivotFieldRole.Measure);
    }))</code></pre>
            <p>
                Akıcı API C# olduğu için alan adları ve enum değerleri derleme zamanında
                denetlenir; <code>Area(PivotArea.Roww)</code> gibi bir yazım hatası tarayıcıya
                hiç ulaşmaz.
            </p>
        </div>
    </section>
</main>

<div class="pivot-card">
    <div class="pivot-panel-head"><h2>Olaylar</h2></div>
    <div class="pivot-note" id="eventLog">Bir hücre seçin.</div>
</div>

<script>
    // Named by on-selection-changed / .OnSelectionChanged -- no wiring code needed.
    function pivotSelectionChanged(selection) {
        document.getElementById("eventLog").textContent =
            selection ? `Seçili: ${selection.rowHeader?.join(" / ") ?? "-"}` : "Seçim yok.";
    }

    // The same events are also dispatched on the container, for pages that
    // prefer listening over naming.
    document.getElementById("pivotGrid").addEventListener("pivotforge:dataloaded", event => {
        document.getElementById("eventLog").dataset.rows =
            String(event.detail.result.rowHeaders?.length ?? 0);
    });
</script>
