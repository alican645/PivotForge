@model IReadOnlyList<SalesRecord>
@{
    ViewData["Title"] = "Tarih gruplama örneği";
}

<main class="pivot-shell">
    <header class="pivot-topbar">
        <div class="pivot-brand">
            <strong>Tek tarih kolonundan hiyerarşi</strong>
            <span>@Model.Count kayıt · <code>group-interval</code></span>
        </div>
        <nav class="pivot-actions">
            <a class="pivot-button" asp-controller="Home" asp-action="Index">Tam demo</a>
            <a class="pivot-button primary" asp-controller="Home" asp-action="TagHelpers">TagHelper sürümü</a>
        </nav>
    </header>

    <section class="pivot-content">
        <div class="pivot-card">
            <div class="pivot-panel-head">
                <h2>Nasıl çalışıyor?</h2>
            </div>
            <p>
                Satır ekseninde <code>OrderDate</code> iki kez bildirilmiş: bir kez
                <code>group-interval="Year"</code>, bir kez <code>group-interval="Month"</code>.
                Kaynakta tek bir tarih kolonu var — yıl ve ay için ayrı kolon açılmıyor.
                Ay adı sunucunun kültüründen geliyor ve <strong>takvim sırasına</strong> göre
                diziliyor; alfabetik olsaydı Ağustos, Nisan'dan önce gelirdi.
            </p>
            <p>
                Sütun ekseni de aynı kolonun çeyrek ve haftanın-günü seviyelerini kullanıyor.
                Sütun ekseni normalde verinin geliş sırasını korur; motorun kendi ürettiği grup
                etiketleri istisnadır, çünkü orada korunacak bir sorgu niyeti yoktur.
            </p>
            <p>
                Çeyrek × haftanın günü 28 sütun eder; sayfa <code>Bölge = Ege</code> ile
                sınırlandığı için bu kadar kayıt hepsine denk gelmiyor.
                <code>hide-empty-summary-cells="true"</code> hiç veri düşmeyen sütunları
                <strong>motorda</strong> düşürüyor — tarayıcıda gizlemek, sayfalamanın
                kimsenin göremediği satırları saymasına yol açardı.
            </p>
        </div>

        <div class="pivot-workspace">
            <aside class="pivot-sidebar" aria-label="PivotTable alanları">
                <div id="groupingDesignerHost" aria-label="Pivot alan tasarımcısı"></div>
            </aside>

            <div class="pivot-card">
                <pivot-grid id="groupingGrid"
                            allow-sorting="true"
                            allow-filtering="true"
                            allow-drill-down="true"
                            source-row-count="@Model.Count"
                            min-column-width="96"
                            total-text="Genel Toplam"
                            aria-label="Yıl ve ay bazında satışlar"
                            culture="tr-TR"
                            hide-empty-summary-cells="true"
                            field-designer="#groupingDesignerHost">
                    <pivot-field field="OrderDate" caption="Yıl" area="Row" group-interval="Year" />
                    <pivot-field field="OrderDate" caption="Ay" area="Row" group-interval="Month" />
                    <pivot-field field="OrderDate" caption="Çeyrek" area="Column" group-interval="Quarter" />
                    <pivot-field field="OrderDate" caption="Haftanın Günü" area="Column"
                                 group-interval="DayOfWeek" />
                    <pivot-field field="Amount" caption="Tutar" area="Data" aggregation="Sum"
                                 format-type="Currency" format-decimals="0" format-currency="TRY" />
                    <pivot-field field="Region" caption="Bölge" area="Available" role="Dimension" />
                    @* A slice narrow enough that the column product outgrows it, which is when
                       empty columns show up in real reports. *@
                    <pivot-filter field="Region" values="Ege" />
                </pivot-grid>
            </div>
        </div>

        <div class="pivot-card">
            <div class="pivot-panel-head">
                <h2>Kaynağı</h2>
            </div>
            <pre><code>&lt;pivot-grid id="groupingGrid" field-designer="#groupingDesignerHost" culture="tr-TR"&gt;
    &lt;pivot-field field="OrderDate" caption="Yıl"     area="Row"    group-interval="Year" /&gt;
    &lt;pivot-field field="OrderDate" caption="Ay"      area="Row"    group-interval="Month" /&gt;
    &lt;pivot-field field="OrderDate" caption="Çeyrek"  area="Column" group-interval="Quarter" /&gt;
    &lt;pivot-field field="Amount"    caption="Tutar"   area="Data"   aggregation="Sum" /&gt;
&lt;/pivot-grid&gt;</code></pre>
        </div>
    </section>
</main>
