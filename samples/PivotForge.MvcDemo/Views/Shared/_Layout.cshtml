<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - PivotForge</title>
    <link rel="stylesheet" href="~/_content/PivotForge.AspNetCore/css/pivotforge.css" asp-append-version="true">
    @* Loaded in the head so the markup helpers rendered by RenderBody can call PivotForge.create inline. *@
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-table.js" asp-append-version="true"></script>
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-request-builder.js" asp-append-version="true"></script>
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-widget.js" asp-append-version="true"></script>
    @* The designer needs both the layout state and the widget, so it loads last. *@
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-layout-state.js" asp-append-version="true"></script>
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-field-designer.js" asp-append-version="true"></script>
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-view-storage.js" asp-append-version="true"></script>
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-drill-down.js" asp-append-version="true"></script>
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-drill-down-modal.js" asp-append-version="true"></script>
    <script src="~/_content/PivotForge.AspNetCore/js/pivot-virtual-data-source.js" asp-append-version="true"></script>
</head>
<body>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
